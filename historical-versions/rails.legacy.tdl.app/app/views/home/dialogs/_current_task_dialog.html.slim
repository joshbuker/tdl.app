v-dialog[v-model='currentTaskDialog' :fullscreen='$vuetify.breakpoint.mobile']
  v-card[:tile='$vuetify.breakpoint.mobile']
    template[v-if='$vuetify.breakpoint.mobile']
      v-card-title.headline.justify-center.mt-1 Task Details
    template[v-else]
      v-card-title.headline.float-left.mt-1 Task Details
    v-row.pt-3[justify='center' no-gutters]
      template[v-if='currentTask.completed']
        v-btn.ma-2.darken-1[color='indigo' @click='markTaskIncomplete(currentTask)' :small='$vuetify.breakpoint.mobile' text-with-icon]
          v-icon[left :small='$vuetify.breakpoint.mobile']
            | fa-undo
          | Mark Incomplete
      template[v-else]
        v-btn.ma-2.darken-1[color='primary' @click='markTaskComplete(currentTask)' :small='$vuetify.breakpoint.mobile' text-with-icon]
          v-icon[left :small='$vuetify.breakpoint.mobile']
            | fa-check
          | Mark Complete
      v-btn.ma-2[color='red' @click='deleteTask(currentTask)' :small='$vuetify.breakpoint.mobile' text-with-icon]
        v-icon[left :small='$vuetify.breakpoint.mobile']
          | fa-trash
        | Delete
      v-btn.ma-2[@click='currentTaskDialog = false' color='secondary' :small='$vuetify.breakpoint.mobile'] Close
    v-divider
    v-card-text
      h3.primary--text
        | {{ currentTask.title }}
      v-row
        v-col
          v-text-field[label='Task title' :placeholder='currentTask.title' v-model='editTaskTitle' @keyup.enter='updateTaskTitle' clearable]
          v-select[label='Tags' v-model='currentTags' @input='updateTags' :items='tags' item-text='title' item-value='title' multiple clearable]
            template v-slot:selection="{ item, index }"
              v-chip[:color='item.color' :text-color='item.text_color' :key='item.title']
                | {{ item.title }}
          v-select[label='List' v-model='currentList' @input='updateTaskList' :items='lists' item-text='title' item-value='title']
          v-row style='flex-wrap: nowrap;'
            v-col.flex-grow-1.flex-shrink-0
              v-datetime-picker[label='Review at' v-model='editReviewAt' @input='updateReviewAt']
            v-col.flex-grow-0.flex-shrink-1
              v-switch[label='Remind me' v-model='editRemindMe' @change='updateRemindMe' style='white-space: nowrap;']
          v-textarea[label='Notes' placeholder='Write some notes...' v-model='currentTask.notes' @change='updateNotes']
        v-col
          v-row.pa-3
            h5
              | Prerequisites
            v-spacer
            v-btn[color='indigo' @click='addPreDialog = true']
              v-icon[left]
                | fa-link
              | Add Prerequisite
          v-list
            v-list-item-group
              v-list-item[v-for='task in currentPrereqs' :key='task.title']
                v-list-item-content[@click.stop='setCurrentTask(task)']
                  v-list-item-title
                    | {{ task.title }}
                v-chip.ml-1[v-if='task.completed' color='success']
                  | Completed
                v-chip.ml-1[v-for='tag in task.tags' :color='tag.color' :text-color='tag.text_color' :key='tag.title']
                  v-icon
                    | fa-tag
                v-list-item-action
                  v-btn[icon color='red' @click.stop='removePrerequisite(task)']
                    v-icon
                      | fa-unlink
              v-list-item[v-if="currentPrereqs.length == 0"]
                v-list-item-content
                  v-list-item-title
                    strong No prerequisites.
          v-divider
          v-row.pa-3
            h5
              | Postrequisites
            v-spacer
            v-btn[color='indigo' @click='addPostDialog = true']
              v-icon[left]
                | fa-link
              | Add Postrequisite
          v-list
            v-list-item-group
              v-list-item[v-for='task in currentPostreqs' :key='task.title']
                v-list-item-content[@click.stop='setCurrentTask(task)']
                  v-list-item-title
                    | {{ task.title }}
                v-chip.ml-1[v-if='task.completed' color='success']
                  | Completed
                v-chip.ml-1[v-for='tag in task.tags' :color='tag.color' :text-color='tag.text_color' :key='tag.title']
                  v-icon
                    | fa-tag
                v-list-item-action
                  v-btn[icon color='red' @click.stop='removePostrequisite(task)']
                    v-icon
                      | fa-unlink
              v-list-item[v-if="currentPostreqs.length == 0"]
                v-list-item-content
                  v-list-item-title
                    strong No postrequisites.
