import axios from 'axios'
import $ from 'jquery'

<% tags_url = Rails.application.routes.url_helpers.tags_url %>

const token = $('meta[name="csrf-token"]').attr('content');

export default {
  async createTag(options, onSuccess, onFailure) {
    return axios.post('<%= tags_url %>', {
      title: options.title,
      order: options.order,
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async deleteTag(options, onSuccess, onFailure) {
    return axios.delete('<%= tags_url %>/' + options.id, {
      headers: {
        credentials: 'same-origin',
        'X-CSRF-Token': token,
        'authenticity_token': token
      }
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async refreshTags(onSuccess, onFailure) {
    return axios.get('<%= tags_url %>').
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async refreshNoTagsCount(onSuccess, onFailure) {
    return axios.get('<%= tags_url %>/no-tags-count').
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async updateTag(options, onSuccess, onFailure) {
    return axios.patch('<%= tags_url %>/' + String(options.id), {
      title: options.title,
      color: options.color,
      order: options.order,
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  }
}
