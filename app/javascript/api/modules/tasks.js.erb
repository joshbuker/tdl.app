    }).
    catch(error => {
      onFailure(error);
    });
  },
  async removePrereq(options, onSuccess, onFailure) {
    return axios.delete('<%= tasks_url %>/' + String(options.id) + '/pre/' + options.pre_task_id, {
      headers: {
        credentials: 'same-origin',
        'X-CSRF-Token': token,
        'authenticity_token': token
      }
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async updateTaskList(options, onSuccess, onFailure) {
    return axios.patch('<%= tasks_url %>/' + String(options.id) + '/list', {
      list_title: options.list_title,
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async updateTaskNotes(options, onSuccess, onFailure) {
    return axios.patch('<%= tasks_url %>/' + String(options.id) + '/notes', {
      notes: options.notes,
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async updateTaskReviewAt(options, onSuccess, onFailure) {
    return axios.patch('<%= tasks_url %>/' + String(options.id) + '/review-at', {
      review_at: options.review_at,
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async updateTaskTags(options, onSuccess, onFailure) {
    return axios.patch('<%= tasks_url %>/' + String(options.id) + '/tags', {
