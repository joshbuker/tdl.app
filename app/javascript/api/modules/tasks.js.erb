import axios from 'axios'
import $ from 'jquery'

<% tasks_url = Rails.application.routes.url_helpers.tasks_url %>

const token = $('meta[name="csrf-token"]').attr('content');

export default {
  async addPostreq(options, onSuccess, onFailure) {
    return axios.patch('<%= tasks_url %>/' + String(options.id) + '/post', {
      post_task_id: options.post_task_id,
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async addPrereq(options, onSuccess, onFailure) {
    return axios.patch('<%= tasks_url %>/' + String(options.id) + '/pre', {
      pre_task_id: options.pre_task_id,
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async clearCompleted(onSuccess, onFailure) {
    return axios.post('<%= tasks_url %>/clear-completed', {
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async createTask(options, onSuccess, onFailure) {
    return axios.post('<%= tasks_url %>', {
      title: options.title,
      // Used by create dialog
      tags: options.tags,
      list: options.list,
      // Used by quick create
      time: options.time,
      limiter_type: options.limiter_type,
      limiter_value: options.limiter_value,
      //
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async deleteTask(options, onSuccess, onFailure) {
    return axios.delete('<%= tasks_url %>/' + options.id, {
      headers: {
        credentials: 'same-origin',
        'X-CSRF-Token': token,
        'authenticity_token': token
      }
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async fetchPostreqs(options, onSuccess, onFailure) {
    return axios.get('<%= tasks_url %>/' + String(options.id) + '/postreqs').
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async fetchPrereqs(options, onSuccess, onFailure) {
    return axios.get('<%= tasks_url %>/' + String(options.id) + '/prereqs').
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async fetchTreePostreqs(options, onSuccess, onFailure) {
    return axios.get('<%= tasks_url %>/' + String(options.id) + '/tree-postreqs').
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async markTaskComplete(options, onSuccess, onFailure) {
    return axios.patch('<%= tasks_url %>/' + String(options.id) + '/complete', {
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async markTaskIncomplete(options, onSuccess, onFailure) {
    return axios.patch('<%= tasks_url %>/' + String(options.id) + '/incomplete', {
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  // TODO: Clean up this request/endpoint to just return tasks without params
  async refreshTasks(onSuccess, onFailure) {
    return axios.post('<%= tasks_url %>', {
      limiter_type: 'list',
      limiter_value: 'All Tasks',
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async refreshTreeview(options, onSuccess, onFailure) {
    return axios.post('<%= tasks_url %>/treeview', {
      limiter_type: options.limiter_type,
      limiter_value: options.limiter_value,
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async removePostreq(options, onSuccess, onFailure) {
    return axios.delete('<%= tasks_url %>/' + String(options.id) + '/post/' + options.post_task_id, {
      headers: {
