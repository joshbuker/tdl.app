  async updateTaskTitle(options, onSuccess, onFailure) {
    return axios.patch('<%= tasks_url %>/' + String(options.id), {
      title: options.title,
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async search(options, onSuccess, onFailure) {
    return axios.post('<%= tasks_url %>/search', {
      title: options.title,
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  }
}
