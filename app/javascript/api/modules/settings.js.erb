import axios from 'axios'
import $ from 'jquery'

<% timezone_url = Rails.application.routes.url_helpers.timezone_url %>

const token = $('meta[name="csrf-token"]').attr('content');

export default {
  async fetchTimezone(onSuccess, onFailure) {
    return axios.get('<%= timezone_url %>').
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  },
  async updateTimezone(options, onSuccess, onFailure) {
    return axios.patch('<%= timezone_url %>', {
      timezone: options.timezone,
      credentials: 'same-origin',
      'X-CSRF-Token': token,
      'authenticity_token': token
    }).
    then(response => {
      onSuccess(response);
    }).
    catch(error => {
      onFailure(error);
    });
  }
}
