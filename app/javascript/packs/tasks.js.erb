import Vue from 'vue/dist/vue.esm'
import App from '../app.vue'
import Vuetify from 'vuetify'
import Vuex from 'vuex'
import { mapActions, mapGetters, mapState } from 'vuex'
import draggable from 'vuedraggable';

import toastr from 'toastr'
import axios from 'axios'
import bootstrap from 'bootstrap'
import DatetimePicker from 'vuetify-datetime-picker'
import $ from 'jquery'
import _ from 'lodash'
import moment from 'moment-timezone'

import store from '../store'

Vue.use(Vuex)
Vue.use(Vuetify)
Vue.use(DatetimePicker)

const opts = {
  icons: {
    iconfont: 'fa4'
  },
  theme: {
    dark: true,
    themes: {
      dark: {
        primary: "#33cc33"
      }
    }
  }
}

// Expose moment to everything via Vue
Vue.prototype.$moment = moment;

export default new Vuetify(opts)

document.addEventListener('DOMContentLoaded', () => {
  const app = new Vue({
    el:'main#root',
    vuetify: new Vuetify(),
    store: store,
    data: {
      //
      // UI Tracking
      //
      addPreDialog: false,
      addPostDialog: false,
      controls: 0,
      createTaskDialog: false,
      createTaskTags: [],
      createTaskList: null,
      currentTaskDialog: false,
      drawer: null,
      editControls: false,
      editNotes: '',
      editRemindMeAt: '',
      editTagDialog: false,
      editTagTitle: '',
      editTaskTitle: '',
      newList: '',
      newTag: '',
      newTask: '',
      newQuickTodayTask: '',
      newQuickTomorrowTask: '',
      newQuickUpcomingTask: '',
      newQuickSomedayTask: '',
      tagToBeEdited: {},
      treeActive: [],
      requestCount: 0,
      searchEnabled: true,
      selectedList: null,
      selectedTag: null,
      view: 0,
      //
      // AJAX variables (TODO: convert to Vuex store)
      //
      currentTask: {},
      currentTags: [],
      currentPrereqs: [],
      currentPostreqs: [],
      currentList: '',
      tags: [],
      search: [],
      today: [],
      tomorrow: [],
      upcoming: [],
      someday: [],
      treeTasks: []
    },
    components: {
      draggable
    },
    created: function() {
      this.refreshEverything();
      this.debouncedSearch = _.debounce(this.searchForTasks, 400);
    },
    computed: {
      limiterType() {
        if(this.controls == 0) {
          return 'list';
        } else {
          return 'tag';
        }
      },
      limiterValue() {
        if(this.limiterType == 'list') {
          return this.selectedList;
        } else {
          return this.selectedTag;
        }
      },
      // tagTextColor() {
      //   if(this.tagToBeEdited && this.tagToBeEdited.color) {
      //     return this.textColor(this.tagToBeEdited.color);
      //   } else {
      //     return '#000000';
      //   }
      // },
      processing() {
        if(this.requestCount == 0) {
          return false;
        } else {
          return true;
        }
      },
      treeSelected() {
        if(!this.treeActive.length) return undefined;
        if(!this.treeTasks.length) return undefined;

        const title = this.treeActive[0];

        return this.findTreeTask(this.treeTasks, title);
      },
      ...mapGetters({
        count: 'lists/allTasksCount'
      }),
      ...mapState({
        lists: state => state.lists.lists
      })
    },
    methods: {
      addTask(){
        axios.post('<%= tasks_url %>', {
          title: this.newTask,
          tags: this.createTaskTags,
          list: this.createTaskList,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshTasks();
          this.newTask = '';
          toastr.success('Added new task!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      addPrerequisite(task){
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id) + '/pre', {
          pre_task_id: task.id,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshTasks();
          this.currentPrereqs.push(response.data);
          toastr.success('Added prerequisite!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      addPreTask(){
        axios.post('<%= tasks_url %>', {
          title: this.newTask,
          tags: this.currentTags.map(item => item.title),
          list: this.currentList,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.today.push(response.data);
          this.newTask = '';
          toastr.success('Added new task!');
          this.addPrerequisite(this.today[this.today.length - 1]);
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      addPostrequisite(task){
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id) + '/post', {
          post_task_id: task.id,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshTasks();
          this.currentPostreqs.push(response.data);
          toastr.success('Added postrequisite!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      addPostTask(){
        axios.post('<%= tasks_url %>', {
          title: this.newTask,
          tags: this.currentTags.map(item => item.title),
          list: this.currentList,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.today.push(response.data);
          this.newTask = '';
          toastr.success('Added new task!');
          this.addPostrequisite(this.today[this.today.length - 1]);
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      clearCompleted: function() {
        if(confirm('This will delete all completed tasks, are you sure?')) {
          axios.post('<%= tasks_url %>/clear-completed', {
            credentials: 'same-origin',
            'X-CSRF-Token': token,
            'authenticity_token': token
          }).
          then(response => {
            this.refreshEverything();
            toastr.success('Cleared completed tasks!');
          }).
          catch(e => {
            toastr.error(e.message);
          });
        }
      },
      increment () {
        this.$store.dispatch('lists/incrementAction')
      },
      createList: function() {
        this.$store.dispatch(
          'lists/createList',
          this.newList,
          () => {
            this.newList = '';
            toastr.success('Added new list!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      createTag: function() {
        axios.post('<%= tags_url %>', {
          title: this.newTag,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.tags.push(response.data);
          this.newTag = '';
          toastr.success('Added new tag!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      createQuickTask: function (taskTime, taskTitle) {
        axios.post('<%= tasks_url %>', {
          title: taskTitle,
          time: taskTime,
          limiter_type: this.limiterType,
          limiter_value: this.limiterValue,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.newQuickTodayTask = '';
          this.newQuickTomorrowTask = '';
          this.newQuickUpcomingTask = '';
          this.newQuickSomedayTask = '';
          this.refreshTasks();
          toastr.success('Added new task!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      deleteList: function(list) {
        if(confirm('This will delete your list and any tasks in it, are you sure?')) {
          axios.delete('<%= lists_url %>/' + list.id, {
            headers: {
              credentials: 'same-origin',
              'X-CSRF-Token': token,
              'authenticity_token': token
            }
          }).
          then(response => {
            this.refreshLists();
            this.refreshTasks();
            toastr.success('Deleted list!');
          }).
          catch(e => {
            toastr.error(e.message);
          });
        }
      },
      deleteTag: function(tag) {
        if(confirm('This will delete your tag, are you sure?')) {
          axios.delete('<%= tags_url %>/' + tag.id, {
            headers: {
              credentials: 'same-origin',
              'X-CSRF-Token': token,
              'authenticity_token': token
            }
          }).
          then(response => {
            this.refreshTags();
            this.refreshTasks();
            toastr.success('Deleted tag!');
          }).
          catch(e => {
            toastr.error(e.message);
          });
        }
      },
      deleteTask(task) {
        if(confirm('Deleting this task cannot be undone, are you sure?')) {
          axios.delete('<%= tasks_url %>/' + task.id, {
            headers: {
              credentials: 'same-origin',
              'X-CSRF-Token': token,
              'authenticity_token': token
            }
          }).
          then(response => {
            this.currentTask = {};
            this.currentTaskDialog = false;
            toastr.success('Deleted task!');
            this.refreshTasks();
          }).
          catch(e => {
            toastr.error(e.message);
          });
        }
      },
      editList() {
        alert('I do like turtles');
      },
      editTag(tag) {
        this.editTagDialog = true;
        this.tagToBeEdited = tag;
        this.editTagTitle = this.tagToBeEdited.title;
      },
      findTreeTask(items, title) {
        if(!items) return;

        for(const item of items) {
          if(item.title === title) return item;

          const child = this.findTreeTask(item.postreqs, title);
          if(child) {
            return child;
          }
        }
      },
      async loadPostreqs(task) {
        return axios.get('<%= tasks_url %>/' + String(task.id) + '/tree-postreqs').
        then(response => {
          task.postreqs = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      markTaskComplete(task){
        this.currentTaskDialog = false;
        axios.patch('<%= tasks_url %>/' + String(task.id) + '/complete', {
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.currentTask = {};
          toastr.success('Completed task!');
          this.refreshTasks();
        }).
        catch(e => {
          this.currentTaskDialog = true;
          toastr.error(e.message);
        });
      },
      markTaskIncomplete(task){
        this.currentTaskDialog = false;
        axios.patch('<%= tasks_url %>/' + String(task.id) + '/incomplete', {
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.currentTask = {};
          toastr.success('Uncompleted task!');
          this.refreshTasks();
        }).
        catch(e => {
          this.currentTaskDialog = true;
          toastr.error(e.message);
        });
      },
      refreshLists() {
        axios.get('<%= lists_url %>').
        then(response => {
          this.lists = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      refreshTags() {
        axios.get('<%= tags_url %>').
        then(response => {
          this.tags = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      // TODO: Extract into separate methods for each group
      refreshTasks() {
        // Today
        axios.post('<%= tasks_url %>/today', {
          limiter_type: this.limiterType,
          limiter_value: this.limiterValue,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.today = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Tomorrow
        axios.post('<%= tasks_url %>/tomorrow', {
          limiter_type: this.limiterType,
          limiter_value: this.limiterValue,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.tomorrow = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Upcoming
        axios.post('<%= tasks_url %>/upcoming', {
          limiter_type: this.limiterType,
          limiter_value: this.limiterValue,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.upcoming = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Someday
        axios.post('<%= tasks_url %>/someday', {
          limiter_type: this.limiterType,
          limiter_value: this.limiterValue,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.someday = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        this.refreshTreeTasks();
      },
      refreshTreeTasks() {
        axios.post('<%= tasks_url %>/treeview', {
          limiter_type: this.limiterType,
          limiter_value: this.limiterValue,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.treeTasks = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      refreshEverything() {
        this.refreshLists();
        this.refreshTags();
        this.refreshTasks();
      },
      removePrerequisite(task){
        if(confirm('Are you sure?')) {
          axios.delete('<%= tasks_url %>/' + String(this.currentTask.id) + '/pre/' + task.id, {
            headers: {
              credentials: 'same-origin',
              'X-CSRF-Token': token,
              'authenticity_token': token
            }
          }).
          then(response => {
            this.refreshTasks();
            this.currentPrereqs = response.data;
            toastr.success('Removed prerequisite!');
          }).
          catch(e => {
            toastr.error(e.message);
          });
        }
      },
      removePostrequisite(task){
        if(confirm('Are you sure?')) {
          axios.delete('<%= tasks_url %>/' + String(this.currentTask.id) + '/post/' + task.id, {
            headers: {
              credentials: 'same-origin',
              'X-CSRF-Token': token,
              'authenticity_token': token
            }
          }).
          then(response => {
            this.refreshTasks();
            this.currentPostreqs = response.data;
            toastr.success('Removed postrequisite!');
          }).
          catch(e => {
            toastr.error(e.message);
          });
        }
      },
      resetTagEdit() {
        this.editTagDialog = false;
        this.tagToBeEdited = {
          title: 'Placeholder',
          color: '#000000'
        };
        this.editTagTitle = '';
      },
      setCurrentTask(task) {
        this.currentTask = task;
        this.currentTags = task.tags;
        this.currentList = task.list_title;
        this.editTaskTitle = task.title;
        this.editRemindMeAt = task.remind_me_at;
        this.newTask = '';
        this.createTaskDialog = false;
        // Fetch pres
        axios.get('<%= tasks_url %>/' + String(task.id) + '/prereqs').
        then(response => {
          this.currentPrereqs = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Fetch posts
        axios.get('<%= tasks_url %>/' + String(task.id) + '/postreqs').
        then(response => {
          this.currentPostreqs = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        this.currentTaskDialog = true;
      },
      syncTaskOrdering(){
        var lists = [this.today, this.tomorrow, this.upcoming, this.someday];
        for(var list of lists) {
          for(var task of list) {
            var current_order = list.indexOf(task) + 1;
            // TODO: Handle ordering tagless tasks
            if(this.limiterType == 'tag') {
              var tag_order = task.tag_ordering.find( ({ title }) => title == this.limiterValue ).order;
              if(current_order != tag_order) {
                axios.patch('<%= tasks_url %>/' + String(task.id) + '/order', {
                  tag_title: this.limiterValue,
                  order: current_order,
                  credentials: 'same-origin',
                  'X-CSRF-Token': token,
                  'authenticity_token': token
                }).
                then(response => {
                  toastr.success('Ordering updated');
                }).
                catch(e => {
                  toastr.error(e.message);
                });
              }
            } else {
              if(current_order != task.order) {
                axios.patch('<%= tasks_url %>/' + String(task.id) + '/order', {
                  order: current_order,
                  credentials: 'same-origin',
                  'X-CSRF-Token': token,
                  'authenticity_token': token
                }).
                then(response => {
                  toastr.success('Ordering updated');
                }).
                catch(e => {
                  toastr.error(e.message);
                });
              }
            }
          }
        }
      },
      textColor(backgroundColor) {
        // Javascript seems to hate guard clauses like I hate javascript
        if(!backgroundColor || 0 === backgroundColor.length) {
          return '#000000';
        } else {
          let input = backgroundColor.toString().replace('#', '');
          if(input.length != 6) {
            return '#000000';
          } else {
            let red = parseInt(input.substr(0,2), 16);
            let green = parseInt(input.substr(2,2), 16);
            let blue = parseInt(input.substr(4,2), 16);
            // Luminance values for different hues are not equal.
            let greyscale = red * 0.299 + green * 0.587 + blue * 0.114;
            // Perceived midpoint for grey is higher than 128. (around 186)
            let midpoint = 152;
            return (greyscale > midpoint) ? '#000000' : '#ffffff';
          }
        }
      },
      updateList() {
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id) + '/list', {
          list_title: this.currentList,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshLists();
          this.refreshTasks();
          this.currentTask.list_title = response.data;
          this.currentList = this.currentTask.list_title;
          toastr.success('Updated list!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      updateNotes: function() {
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id) + '/notes', {
          notes: this.currentTask.notes,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.currentTask.notes = response.data;
          toastr.success('Updated notes!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      updateRemindMeAt() {
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id) + '/remind-me-at', {
          remind_me_at: this.editRemindMeAt,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshTasks();
          toastr.success('Updated remind me at!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      updateTag() {
        axios.patch('<%= tags_url %>/' + String(this.tagToBeEdited.id), {
          title: this.editTagTitle,
          color: this.tagToBeEdited.color,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          if(this.tagToBeEdited.title == this.selectedTag) {
            this.selectedTag = this.editTagTitle;
          }
          this.tagToBeEdited.title = this.editTagTitle;
          this.editTagTitle = '';
          this.refreshTags();
          this.refreshTasks();
          this.editTagDialog = false;
          toastr.success('Updated tag!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      updateTags() {
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id) + '/tags', {
          tag_titles: this.currentTags,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshEverything();
          this.currentTask.tags = response.data;
          this.currentTags = this.currentTask.tags.map( function(tag) { return tag.title } );
          toastr.success('Updated tags!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      updateTaskTitle() {
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id), {
          title: this.editTaskTitle,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshEverything();
          this.currentTask.title = this.editTaskTitle;
          this.editTaskTitle = '';
          toastr.success('Updated task title!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      searchForTasks() {
        axios.post('<%= tasks_url %>/search', {
          title: this.newTask,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.search = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      selectTag(tag) {
        this.selectedTag = tag.title;
        if(this.controls == 0) {
          this.controls = 1;
        }
        this.refreshTasks();
      },
      logout() {
        axios.post('<%= logout_url %>', {
          credentials: 'same-origin',
          dataType: 'json',
          contentType: 'application/json',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          window.location.reload();
        }).
        catch(error => {
          toastr.error(error.message);
        })
      }
    },
    watch: {
      newTask: function(newValue, oldValue) {
        if(!this.searchEnabled) {
          return;
        }
        this.debouncedSearch();
      }
    }
  })

  // Add a request interceptor
  axios.interceptors.request.use(function (config) {
      app.requestCount += 1;
      return config;
    }, function (error) {
      // TODO: Should this do nothing or decrement requestCount?
      return Promise.reject(error);
    });

  // Add a response interceptor
  axios.interceptors.response.use(function (response) {
      // Any status code that lie within the range of 2xx cause this function to trigger
      app.requestCount -= 1;
      return response;
    }, function (error) {
      // Any status codes that falls outside the range of 2xx cause this function to trigger
      app.requestCount -= 1;
      return Promise.reject(error);
    });
})
