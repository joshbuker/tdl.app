            this.refreshLists();
            this.refreshTasks();
            this.currentTask.list_title = response.data;
            this.currentList = this.currentTask.list_title;
            toastr.success('Updated list!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      updateReviewAt() {
        this.$store.dispatch('tasks/updateReviewAt', {
          id: this.currentTask.id,
          review_at: this.editReviewAt
        }).
        then(
          (response) => {
            this.refreshTasks();
            toastr.success('Updated review at!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      updateList() {
        const previousListTitle = this.listToBeEdited.title;
        this.$store.dispatch('lists/update', {
          id: this.listToBeEdited.id,
          title: this.editListTitle
        }).
        then(
          (response) => {
            if(previousListTitle == this.selectedList) {
              this.selectedList = this.editListTitle;
            }
            this.refreshTasks();
            this.resetListEdit();
            toastr.success('Updated list!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      updateTag() {
        const previousTagTitle = this.tagToBeEdited.title;
        this.$store.dispatch('tags/update', {
          id: this.tagToBeEdited.id,
          title: this.editTagTitle,
          color: this.editTagColor
        }).
        then(
          (response) => {
            if(this.selectedTags.includes(previousTagTitle)) {
              const index = this.selectedTags.findIndex(this.editTagTitle);
              this.selectedTags.splice(index, 1, this.editTagTitle);
            }
            this.refreshTasks();
            this.resetTagEdit();
            toastr.success('Updated tag!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      updateTags() {
        this.$store.dispatch('tasks/updateTags', {
          id: this.currentTask.id,
          tag_titles: this.currentTags
        }).
        then(
          (response) => {
            this.refreshEverything();
            this.currentTask.tags = response.data;
            this.currentTags = this.currentTask.tags.map( function(tag) { return tag.title } );
            toastr.success('Updated tags!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      updateTaskTitle() {
        this.$store.dispatch('tasks/updateTitle', {
          id: this.currentTask.id,
          title: this.editTaskTitle
        }).
        then(
          (response) => {
            this.refreshEverything();
            this.currentTask.title = this.editTaskTitle;
            this.editTaskTitle = '';
            toastr.success('Updated task title!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      searchForTasks(title) {
        this.$store.dispatch('tasks/search', {
          title: title
        }).
        catch(
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      selectTag(tag) {
        this.selectedTags = [tag.title];
        if(this.controls == 0) {
          this.controls = 1;
        }
      },
      showLocalNotification(title, body, serviceWorker) {
        const options = {
          body,
          icon: "<%= appIcon %>"
        };
        if(this.serviceWorker != null) {
          this.serviceWorker.showNotification(title, options);
        } else {
          toastr.error('Service worker is null!');
        }
      },
      logout() {
        api.logout(
          (response) => {
            window.location.reload();
          },
          (error) => {
            toastr.error(error.message);
          }
        )
      }
    }
    // Temporarily disabled due to abyssmal performance on mobile
    // watch: {
    //   newTask(newValue, oldValue) {
    //     if(!this.searchEnabled) {
    //       return;
    //     }
    //     this.debouncedSearch();
    //   }
    // }
  })

  // Add a request interceptor
  axios.interceptors.request.use(function (config) {
    app.requestCount += 1;
    return config;
  }, function (error) {
    // TODO: Should this do nothing or decrement requestCount?
    return Promise.reject(error);
  });

  // Add a response interceptor
  axios.interceptors.response.use(function (response) {
    // Any status code that lie within the range of 2xx cause this function to trigger
    app.requestCount -= 1;
    return response;
  }, function (error) {
    // Any status codes that falls outside the range of 2xx cause this function to trigger
    app.requestCount -= 1;
    return Promise.reject(error);
  });
})
