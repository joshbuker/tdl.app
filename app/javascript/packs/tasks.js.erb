import Vue from 'vue/dist/vue.esm'
import App from '../app.vue'
import Vuetify from 'vuetify'
// FIXME: Only include Vuex once?
import Vuex from 'vuex'
import { mapActions, mapGetters, mapState } from 'vuex'
import draggable from 'vuedraggable';

import toastr from 'toastr'
import axios from 'axios'
import $ from 'jquery'
import _ from 'lodash'

// Time - See link for formatting symbols
// https://moment.github.io/luxon/docs/manual/formatting.html#table-of-tokens
import luxon from 'luxon'
import { DateTime } from 'luxon'

import api from '../api'
import store from '../store'
import code from '../code'

import DateTimePicker from '../components/DateTimePicker.vue'

Vue.use(Vuex)
Vue.use(Vuetify)

Vue.component('v-datetime-picker', DateTimePicker)

const opts = {
  icons: {
    iconfont: 'fa4'
  },
  theme: {
    dark: true,
    themes: {
      dark: {
        primary: "#33cc33"
      }
    }
  }
}

<% timezones = ActiveSupport::TimeZone.all.map{ |tz| { name: tz.name, value: tz.tzinfo.name} }.to_json %>

export default new Vuetify(opts)

document.addEventListener('DOMContentLoaded', () => {
  const app = new Vue({
    el:'main#root',
    vuetify: new Vuetify(),
    store: store,
    data: {
      //
      // Pull in modularized data
      //
      ...code.data,
      //
      // UI Tracking
      //
      controls: 0,
      drawer: null,
      editControls: false,
      newList: '',
      newTag: '',
      newQuickTodayTask: '',
      newQuickTomorrowTask: '',
      newQuickUpcomingTask: '',
      newQuickSomedayTask: '',
      requestCount: 0,
      searchEnabled: true,
      selectedList: 'All Tasks',
      selectedTagsJank: [], // Allow custom No Tags logic (replace this plz)
      view: 0,
      //
      // Service worker for notification support
      //
      serviceWorker: null,
      //
      // Show current time on settings page
      //
      currentTime: '',
      //
      // Bake in timezones from Rails
      //
      timezones: JSON.parse('<%= timezones.gsub("\'", "") %>'),
    },
    components: {
      draggable
    },
    created() {
      this.fetchTimezone();
      this.refreshEverything();
      this.debouncedSearch = _.debounce(this.searchForTasks, 400);
      navigator.serviceWorker.register('/service-worker.js').then(registration => {
        console.log('ServiceWorker registered: ', registration);

        var serviceWorker;
        if (registration.installing) {
          serviceWorker = registration.installing;
          console.log('Service worker installing.');
        } else if (registration.waiting) {
          serviceWorker = registration.waiting;
          console.log('Service worker installed & waiting.');
        } else if (registration.active) {
          serviceWorker = registration.active;
          console.log('Service worker active.');
        }

        this.serviceWorker = registration;
        this.serviceWorker.pushManager.getSubscription().
        then(
          (subscription) => {
            if(subscription != null) {
              api.subscribeDevice(
                subscription.toJSON(),
                (response) => {
                  // Do nothing
                },
                (error) => {
                  toastr.error(error.message);
                }
              );
            } else {
              toastr.error(subscription);
            }
          },
          (nay) => {
            toastr.error(nay);
            console.log(':(', nay);
          }
        );
      }).catch(registrationError => {
        console.log('Service worker registration failed: ', registrationError);
        toastr.error('failed to register service worker entirely');
      });
    },
    mounted() {
      this.$options.timer = window.setTimeout(this.updateCurrentTime, 1000);
    },
    beforeDestroy() {
      window.clearTimeout(this.$options.timer);
    },
    computed: {
      //
      // Pull in modularized computed methods
      //
      ...code.computed,
      //
      // Other computed methods
      //
      processing() {
        if(this.requestCount == 0) {
          return false;
        } else {
          return true;
        }
      },
      selectedTags: {
        get() {
          return this.selectedTagsJank;
        },
        set(value) {
          if(value.includes('No Tags')) {
            if(this.selectedTagsJank.includes('No Tags')) {
              this.selectedTagsJank = value.filter(
                (tag) => { return tag != 'No Tags' }
              );
            } else {
              this.selectedTagsJank = ['No Tags'];
            }
          } else {
            this.selectedTagsJank = value;
          }
        }
      },
      ...mapGetters({
        allTasksCount: 'lists/allTasksCount',
        noTagsCount: 'tags/noTagsCount',
        tomorrow: 'tasks/tomorrow',
        upcoming: 'tasks/upcoming',
        someday: 'tasks/someday',
        treeTasks: 'tasks/treeTasks',
        search: 'tasks/search'
      }),
      today: {
        get() {
          var list = this.selectedList;
          var tags = this.selectedTags;
          return this.$store.getters['tasks/today'](list, tags);
        },
        set(value) {}
      },
      tomorrow: {
        get() {
          var list = this.selectedList;
          var tags = this.selectedTags;
          return this.$store.getters['tasks/tomorrow'](list, tags);
        },
        set(value) {}
      },
      upcoming: {
        get() {
          var list = this.selectedList;
          var tags = this.selectedTags;
          return this.$store.getters['tasks/upcoming'](list, tags);
        },
        set(value) {}
      },
      someday: {
        get() {
          var list = this.selectedList;
          var tags = this.selectedTags;
          return this.$store.getters['tasks/someday'](list, tags);
        },
        set(value) {}
      },
      timezone: {
        get() {
          return this.$store.state.settings.timezone;
        },
        set(value) {
          let previousTimezone = this.timezone;
          this.$store.dispatch('settings/updateTimezone', {
            timezone: value
          }).
          then(
            (response) => {
              // The timing of today/tomorrow/etc changes based on timezone...
              this.refreshTasks();
              toastr.success('Timezone updated!')
            },
            (error) => {
              toastr.error(error.message);
            }
          );
        }
      },
      lists: {
        get() {
          return this.$store.state.lists.lists;
        },
        set(value) {
          this.$store.commit('lists/setLists', value);
        }
      },
      tags: {
        get() {
          return this.$store.state.tags.tags;
        },
        set(value) {
          this.$store.commit('tags/setTags', value);
        }
      }
    },
    methods: {
      //
      // Import modularized methods
      //
      ...code.methods,
      //
      // Other methods
      //
      clearCompleted() {
        if(confirm('This will delete all completed tasks, are you sure?')) {
          this.$store.dispatch('tasks/clearCompleted').
          then(
            (response) => {
              this.refreshEverything();
              toastr.success('Cleared completed tasks!');
            },
            (error) => {
              toastr.error(error.message);
            }
          );
        }
      },
      createList() {
        this.$store.dispatch('lists/create', { title: this.newList }).
        then(
          (response) => {
            this.newList = '';
            toastr.success('Added new list!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      createTag() {
        this.$store.dispatch('tags/create', { title: this.newTag }).
        then(
          (response) => {
            this.newTag = '';
            toastr.success('Added new tag!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      createQuickTask(taskTime, taskTitle) {
        this.$store.dispatch('tasks/create', {
          title: taskTitle,
          time: taskTime,
          list: this.selectedList,
          tags: this.selectedTags
        }).
        then(
          (response) => {
            // TODO: Directly add task
            this.newQuickTodayTask = '';
            this.newQuickTomorrowTask = '';
            this.newQuickUpcomingTask = '';
            this.newQuickSomedayTask = '';
            this.refreshTasks();
            toastr.success('Added new task!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      deleteList(list) {
        if(confirm('This will delete your list and any tasks in it, are you sure?')) {
          this.$store.dispatch('lists/delete', { id: list.id }).
          then(
            (response) => {
              // TODO: Directly remove list
              this.refreshLists();
              this.refreshTasks();
              toastr.success('Deleted list!');
            },
            (error) => {
              toastr.error(error.message);
            }
          );
        }
      },
      deleteTag(tag) {
        if(confirm('This will delete your tag, are you sure?')) {
          this.$store.dispatch('tags/delete', { id: tag.id }).
          then(
            (response) => {
              this.refreshTasks();
              toastr.success('Deleted tag!');
            },
            (error) => {
              toastr.error(error.message);
            }
          );
        }
      },
      deleteTask(task) {
        if(confirm('Deleting this task cannot be undone, are you sure?')) {
          this.$store.dispatch('tasks/delete', { id: task.id }).
          then(
            (response) => {
              // TODO: Directly remove task
              this.currentTask = {};
              this.currentTaskDialog = false;
              toastr.success('Deleted task!');
              this.refreshTasks();
            },
            (error) => {
              toastr.error(error.message);
            }
          );
        }
      },
      fetchTimezone() {
        this.$store.dispatch('settings/fetchTimezone').
        catch(
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      refreshLists() {
        this.$store.dispatch('lists/refresh').
        catch(
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      refreshTags() {
        this.$store.dispatch('tags/refresh').
        catch(
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      refreshTasks() {
        this.$store.dispatch('tasks/refresh', {
          limiter_type: this.limiterType,
          limiter_value: this.limiterValue
        }).
        catch(
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      refreshEverything() {
        this.refreshLists();
        this.refreshTags();
        this.refreshTasks();
      },
      resetReviewAt() {
        if(confirm('This will reset review at for anything without a reminder, are you sure?')) {
          console.log('sono');
          this.$store.dispatch('tasks/resetReviewAt').
          then(
            (response) => {
              this.refreshEverything();
              toastr.success('Reset review at for tasks without a reminder!');
            },
            (error) => {
              toastr.error(error.message);
            }
          );
        }
      },
      updateCurrentTime() {
        this.currentTime = DateTime.local().toFormat('h:mm:ss a ZZZZ');
        this.$options.timer = window.setTimeout(this.updateCurrentTime, 1000);
      },
      updateNotes() {
        this.$store.dispatch('tasks/updateNotes', {
          id: this.currentTask.id,
          notes: this.currentTask.notes
        }).
        then(
          (response) => {
            this.currentTask.notes = response.data;
            toastr.success('Updated notes!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      updateTaskList() {
        this.$store.dispatch('tasks/updateList', {
          id: this.currentTask.id,
          list_title: this.currentList
        }).
        then(
          (response) => {
            // TODO: Directly update task/lists
            this.refreshLists();
            this.refreshTasks();
            this.currentTask.list_title = response.data;
            this.currentList = this.currentTask.list_title;
            toastr.success('Updated list!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      updateRemindMe() {
        this.$store.dispatch('tasks/updateRemindMe', {
          id: this.currentTask.id,
          remind_me: this.editRemindMe
        }).
        then(
          (response) => {
            this.editRemindMe = response.data;
            this.refreshTasks(); // TODO: Edit value directly
            toastr.success('Updated remind me!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      updateReviewAt() {
        this.$store.dispatch('tasks/updateReviewAt', {
          id: this.currentTask.id,
          review_at: this.editReviewAt
        }).
        then(
          (response) => {
            this.refreshTasks();
            toastr.success('Updated review at!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      updateTags() {
        this.$store.dispatch('tasks/updateTags', {
          id: this.currentTask.id,
          tag_titles: this.currentTags
        }).
        then(
          (response) => {
            this.refreshEverything();
            this.currentTask.tags = response.data;
            this.currentTags = this.currentTask.tags.map( function(tag) { return tag.title } );
            toastr.success('Updated tags!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      updateTaskTitle() {
        this.$store.dispatch('tasks/updateTitle', {
          id: this.currentTask.id,
          title: this.editTaskTitle
        }).
        then(
          (response) => {
            this.refreshEverything();
            this.currentTask.title = this.editTaskTitle;
            this.editTaskTitle = '';
            toastr.success('Updated task title!');
          },
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      searchForTasks(title) {
        this.$store.dispatch('tasks/search', {
          title: title
        }).
        catch(
          (error) => {
            toastr.error(error.message);
          }
        );
      },
      selectTag(tag) {
        this.selectedTags = [tag.title];
        if(this.controls == 0) {
          this.controls = 1;
        }
      }
    }
    // Temporarily disabled due to abyssmal performance on mobile
    // watch: {
    //   newTask(newValue, oldValue) {
    //     if(!this.searchEnabled) {
    //       return;
    //     }
    //     this.debouncedSearch();
    //   }
    // }
  })

  // Add a request interceptor
  axios.interceptors.request.use(function (config) {
    app.requestCount += 1;
    return config;
  }, function (error) {
    // TODO: Should this do nothing or decrement requestCount?
    return Promise.reject(error);
  });

  // Add a response interceptor
  axios.interceptors.response.use(function (response) {
    // Any status code that lie within the range of 2xx cause this function to trigger
    app.requestCount -= 1;
    return response;
  }, function (error) {
    // Any status codes that falls outside the range of 2xx cause this function to trigger
    app.requestCount -= 1;
    return Promise.reject(error);
  });
})
