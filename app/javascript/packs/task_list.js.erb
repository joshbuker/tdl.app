import Vue from 'vue/dist/vue.esm'
import App from '../app.vue'

import ListControls from "../components/ListControls.vue";
import TagControls from "../components/TagControls.vue";
import TasksDocket from "../components/TasksDocket.vue";

import toastr from 'toastr'
import axios from 'axios'
import bootstrap from 'bootstrap'
import { Datetime } from 'vue-datetime'
import $ from 'jquery'
import _ from 'lodash'
// import '../stylesheets/bootstrap'
// import '../stylesheets/font-awesome'
// import '../stylesheets/toastr'
// // import '../stylesheets/task_list'
// import 'vue-datetime/dist/vue-datetime.css'

Vue.use(Datetime)

Vue.component('datetime', Datetime);

<% tags_url = Rails.application.routes.url_helpers.tags_url %>
<% tasks_url = Rails.application.routes.url_helpers.tasks_url %>
<% lists_url = Rails.application.routes.url_helpers.lists_url %>

const token = $('meta[name="csrf-token"]').attr('content');

document.addEventListener('DOMContentLoaded', () => {
  const app = new Vue({
    el:'main#root',
    data: {
      title: {
        today: 'Today',
        tomorrow: 'Tomorrow',
        upcoming: 'Upcoming',
        someday: 'Someday'
      },
      lists: [],
      tags: [],
      today: [],
      tomorrow: [],
      upcoming: [],
      someday: [],
      search: [],
      controls: 'lists',
      currentTask: {},
      currentPrereqs: [],
      currentPostreqs: [],
      currentTags: [],
      currentList: '',
      newTask: '',
      newList: '',
      newTag: '',
      editTask: '',
      limiterType: null,
      limiterValue: null
    },
    methods: {
      addTask(){
        axios.post('<%= tasks_url %>', {
          title: this.newTask,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.today.push(response.data);
          this.newTask = '';
          $('#createTaskModal').modal('hide');
          toastr.success('Added new task!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      addPreTask(){
        axios.post('<%= tasks_url %>', {
          title: this.newTask,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.today.push(response.data);
          this.newTask = '';
          toastr.success('Added new task!');
          this.addPrerequisite(this.today[this.today.length - 1]);
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      addPostTask(){
        axios.post('<%= tasks_url %>', {
          title: this.newTask,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.today.push(response.data);
          this.newTask = '';
          toastr.success('Added new task!');
          this.addPostrequisite(this.today[this.today.length - 1]);
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      deleteTask(task) {
        if(confirm('Are you sure?')) {
          axios.delete('<%= tasks_url %>/' + task.id, {
            credentials: 'same-origin',
            'X-CSRF-Token': token,
            'authenticity_token': token
          }).
          then(response => {
            this.currentTask = {};
            $('#taskDetailModal').modal('hide');
            toastr.success('Deleted task!');
            this.refreshTaskLists();
          }).
          catch(e => {
            toastr.error(e.message);
          });
        }
      },
      addPrerequisite(task){
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id) + '/pre', {
          pre_task_id: task.id,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshTaskLists();
          this.currentPrereqs.push(response.data);
          toastr.success('Added prerequisite!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      addPostrequisite(task){
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id) + '/post', {
          post_task_id: task.id,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshTaskLists();
          this.currentPostreqs.push(response.data);
          toastr.success('Added postrequisite!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      removePrerequisite(task){
        if(confirm('Are you sure?')) {
          axios.delete('<%= tasks_url %>/' + String(this.currentTask.id) + '/pre/' + task.id, {
            credentials: 'same-origin',
            'X-CSRF-Token': token,
            'authenticity_token': token
          }).
          then(response => {
            this.refreshTaskLists();
            this.currentPrereqs = response.data;
            toastr.success('Removed prerequisite!');
          }).
          catch(e => {
            toastr.error(e.message);
          });
        }
      },
      removePostrequisite(task){
        if(confirm('Are you sure?')) {
          axios.delete('<%= tasks_url %>/' + String(this.currentTask.id) + '/post/' + task.id, {
            credentials: 'same-origin',
            'X-CSRF-Token': token,
            'authenticity_token': token
          }).
          then(response => {
            this.refreshTaskLists();
            this.currentPostreqs = response.data;
            toastr.success('Removed postrequisite!');
          }).
          catch(e => {
            toastr.error(e.message);
          });
        }
      },
      markTaskComplete(task){
        axios.patch('<%= tasks_url %>/' + String(task.id) + '/complete', {
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.currentTask = {};
          $('#taskDetailModal').modal('hide');
          toastr.success('Completed task!');
          this.refreshTaskLists();
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      markTaskIncomplete(task){
        axios.patch('<%= tasks_url %>/' + String(task.id) + '/incomplete', {
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.currentTask = {};
          $('#taskDetailModal').modal('hide');
          toastr.success('Uncompleted task!');
          this.refreshTaskLists();
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      refreshTaskLists(){
        // Today
        axios.post('<%= tasks_url %>/today', {
          limiter_type: this.limiterType,
          limiter_value: this.limiterValue,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.today = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Tomorrow
        axios.post('<%= tasks_url %>/tomorrow', {
          limiter_type: this.limiterType,
          limiter_value: this.limiterValue,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.tomorrow = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Upcoming
        axios.post('<%= tasks_url %>/upcoming', {
          limiter_type: this.limiterType,
          limiter_value: this.limiterValue,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.upcoming = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Someday
        axios.post('<%= tasks_url %>/someday', {
          limiter_type: this.limiterType,
          limiter_value: this.limiterValue,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.someday = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Lists
        axios.get('<%= lists_url %>').
        then(response => {
          this.lists = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Tags
        axios.get('<%= tags_url %>').
        then(response => {
          this.tags = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      searchForTasks(){
        axios.post('<%= tasks_url %>/search', {
          title: this.newTask,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.search = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      selectFromSearch: function(task) {
        this.setCurrentTask(task);
        $('#createTaskModal').modal('hide');
        this.newTask = '';
        $('#taskDetailModal').modal('show');
      },
      setCurrentTask: function (task) {
        app.currentTask = task;
        app.currentTags = task.tags.map( function(tag) { return tag.title } );
        app.currentList = task.list_title;
        app.editTask = '';
        // Fetch pres
        axios.get('<%= tasks_url %>/' + String(task.id) + '/prereqs').
        then(response => {
          app.currentPrereqs = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Fetch posts
        axios.get('<%= tasks_url %>/' + String(task.id) + '/postreqs').
        then(response => {
          app.currentPostreqs = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      createQuickTask: function (taskTime, taskTitle) {
        axios.post('<%= tasks_url %>', {
          title: taskTitle,
          time: taskTime,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          app.refreshTaskLists();
          toastr.success('Added new task!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      createList: function() {
        axios.post('<%= lists_url %>', {
          title: this.newList,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.lists.push(response.data);
          this.newList = '';
          toastr.success('Added new list!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      createTag: function() {
        axios.post('<%= tags_url %>', {
          title: this.newTag,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.tags.push(response.data);
          this.newTag = '';
          toastr.success('Added new tag!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      deleteList: function(list) {
        if(confirm('Are you sure?')) {
          axios.delete('<%= lists_url %>/' + list.id, {
            credentials: 'same-origin',
            'X-CSRF-Token': token,
            'authenticity_token': token
          }).
          then(response => {
            this.refreshTaskLists();
            toastr.success('Deleted list!');
          }).
          catch(e => {
            toastr.error(e.message);
          });
        }
      },
      deleteTag: function(tag) {
        if(confirm('Are you sure?')) {
          axios.delete('<%= tags_url %>/' + tag.id, {
            credentials: 'same-origin',
            'X-CSRF-Token': token,
            'authenticity_token': token
          }).
          then(response => {
            this.refreshTaskLists();
            toastr.success('Deleted tag!');
          }).
          catch(e => {
            toastr.error(e.message);
          });
        }
      },
      setCurrentList: function(list) {
        app.limiterType = 'list';
        app.limiterValue = list.title;
        app.refreshTaskLists();
      },
      setCurrentTag: function(tag) {
        app.limiterType = 'tag';
        app.limiterValue = tag.title;
        app.refreshTaskLists();
      },
      updateTags: function() {
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id) + '/tags', {
          tag_titles: this.currentTags,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshTaskLists();
          this.currentTask.tags = response.data;
          this.currentTags = this.currentTask.tags.map( function(tag) { return tag.title } );
          $('#addTagsModal').modal('hide');
          toastr.success('Updated tags!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      updateList: function() {
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id) + '/list', {
          list_title: this.currentList,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshTaskLists();
          this.currentTask.list_title = response.data;
          this.currentList = this.currentTask.list_title;
          $('#updateListModal').modal('hide');
          toastr.success('Updated list!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      updateNotes: function() {
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id) + '/notes', {
          notes: this.currentTask.notes,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshTaskLists();
          this.currentTask.notes = response.data;
          toastr.success('Updated notes!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      updateRemindMeAt: function() {
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id) + '/remind-me-at', {
          remind_me_at: this.currentTask.remind_me_at,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshTaskLists();
          this.currentTask.remind_me_at = response.data;
          toastr.success('Updated remind me at!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      updateTask: function() {
        axios.patch('<%= tasks_url %>/' + String(this.currentTask.id), {
          title: this.editTask,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.refreshTaskLists();
          this.currentTask.title = this.editTask;
          this.editTask = '';
          toastr.success('Updated task!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      clearCompleted: function() {
        if(confirm('Are you sure?')) {
          axios.post('<%= tasks_url %>/clear-completed', {
            credentials: 'same-origin',
            'X-CSRF-Token': token,
            'authenticity_token': token
          }).
          then(response => {
            this.refreshTaskLists();
            toastr.success('Cleared completed tasks!');
          }).
          catch(e => {
            toastr.error(e.message);
          });
        }
      }
    },
    created: function() {
      // Refresh everything
      this.refreshTaskLists();
      // Set newTask Debouncer
      this.debouncedSearch = _.debounce(this.searchForTasks, 100)
    },
    components: {
      ListControls,
      TagControls,
      TasksDocket
    },
    watch: {
      newTask: function(newValue, oldValue) {
        this.debouncedSearch();
      }
    }
  })
})
