import Vue from 'vue/dist/vue.esm'
import App from '../app.vue'

import ListControls from "../components/ListControls.vue";
import TagControls from "../components/TagControls.vue";
import TasksDocket from "../components/TasksDocket.vue";

import toastr from 'toastr'
import axios from 'axios'
import bootstrap from 'bootstrap'
import $ from 'jquery'
import _ from 'lodash'
import '../stylesheets/bootstrap'
import '../stylesheets/font-awesome'
import '../stylesheets/toastr'
// import '../stylesheets/task_list'

<% Rails.application.default_url_options[:host] = 'localhost:3000' %>
<% tags_url = Rails.application.routes.url_helpers.tags_url %>
<% tasks_url = Rails.application.routes.url_helpers.tasks_url %>
<% lists_url = Rails.application.routes.url_helpers.lists_url %>

const token = $('meta[name="csrf-token"]').attr('content');

document.addEventListener('DOMContentLoaded', () => {
  const app = new Vue({
    el:'main#root',
    data: {
      title: {
        today: 'Today',
        tomorrow: 'Tomorrow',
        upcoming: 'Upcoming',
        someday: 'Someday'
      },
      lists: [],
      tags: [],
      today: [],
      tomorrow: [],
      upcoming: [],
      someday: [],
      search: [],
      controls: 'lists',
      currentTask: {},
      currentPrereqs: [],
      currentPostreqs: [],
      newTask: ''
    },
    methods: {
      addTask(){
        axios.post('<%= tasks_url %>', {
          title: this.newTask,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.today.push(response.data);
          this.newTask = '';
          $('#createTaskModal').modal('hide');
          toastr.success('Added new task!');
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      markTaskComplete(task){
        axios.patch('<%= tasks_url %>/' + String(task.id) + '/complete').
        then(response => {
          this.currentTask = {};
          $('#taskDetailModal').modal('hide');
          toastr.success('Completed task!');
          this.refreshTaskLists();
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      refreshTaskLists(){
        // Today
        axios.get('<%= tasks_url %>/today').
        then(response => {
          this.today = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Tomorrow
        axios.get('<%= tasks_url %>/tomorrow').
        then(response => {
          this.tomorrow = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Upcoming
        axios.get('<%= tasks_url %>/upcoming').
        then(response => {
          this.upcoming = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Someday
        axios.get('<%= tasks_url %>/someday').
        then(response => {
          this.someday = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      searchForTasks(){
        axios.post('<%= tasks_url %>/search', {
          title: this.newTask,
          credentials: 'same-origin',
          'X-CSRF-Token': token,
          'authenticity_token': token
        }).
        then(response => {
          this.search = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
      },
      selectFromSearch: function(task) {
        this.setCurrentTask(task);
        $('#createTaskModal').modal('hide');
        this.newTask = '';
        $('#taskDetailModal').modal('show');
      },
      setCurrentTask: function (task) {
        app.currentTask = task;
        // Fetch pres
        axios.get('<%= tasks_url %>/' + String(task.id) + '/prereqs').
        then(response => {
          app.currentPrereqs = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
        // Fetch posts
        axios.get('<%= tasks_url %>/' + String(task.id) + '/postreqs').
        then(response => {
          app.currentPostreqs = response.data;
        }).
        catch(e => {
          toastr.error(e.message);
        });
      }
    },
    created: function() {
      // Lists
      axios.get('<%= lists_url %>').
      then(response => {
        this.lists = response.data;
      }).
      catch(e => {
        toastr.error(e.message);
      });
      // Tags
      axios.get('<%= tags_url %>').
      then(response => {
        this.tags = response.data;
      }).
      catch(e => {
        toastr.error(e.message);
      });
      // Task Lists
      this.refreshTaskLists();
      // Set newTask Debouncer
      this.debouncedSearch = _.debounce(this.searchForTasks, 100)
    },
    components: {
      ListControls,
      TagControls,
      TasksDocket
    },
    watch: {
      newTask: function(newValue, oldValue) {
        this.debouncedSearch();
      }
    }
  })
})
