import toastr from 'toastr'

<% appIcon = ActionController::Base.helpers.asset_path('favicon/android-chrome-192x192.png') %>

const methods = {
  notifyMe() {
    this.requestNotificationPermission().
    then(
      () => {
        this.showLocalNotification('Bro', 'It works');
      },
      () => {
        toastr.error('Notification permission denied.');
      }
    );
  },
  async requestNotificationPermission() {
    return new Promise(
      (resolve, reject) => {
        window.Notification.requestPermission().
        then(permission => {
          if(permission === 'granted') {
            resolve();
          } else {
            reject();
          }
        })
      }
    );
  },
  showLocalNotification(title, body, serviceWorker) {
    const options = {
      body,
      icon: "<%= appIcon %>"
    };
    if(this.serviceWorker != null) {
      this.serviceWorker.showNotification(title, options);
    } else {
      toastr.error('Service worker is null!');
    }
  }
}

export default {
  methods
}
