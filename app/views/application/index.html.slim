- @user = User.first
main#root
  header.app-header
    .app-header__controls.app-header__controls--start
      button.app-header__control-button
        = render 'bars_svg'
      button.app-header__new-task-button
        = render 'plus_svg'
        span.app-header__new-task-button__text New
    .app-header__controls.app-header__controls--end
      button.app-header__search-button
        = render 'search_svg'
  .app-body
    .app-body__controls.container
      .app-body__controls__select.row
        .col-sm
          h3 Lists
        .col-sm
          h3.active Tags
      .app-body__controls__lists
        ul
          - @user.lists.each do |list|
            - if list.title == 'Action Pending'
              li.active = list.title
            - else
              li = list.title
      .app-body__controls__tags
        ul
          - @user.tags.each do |tag|
            li
              span style="color: #{tag.color};" = tag.title
          li
            span style="color: white;" No Tags
    section.app-body__tasks

= javascript_pack_tag 'task_list'
