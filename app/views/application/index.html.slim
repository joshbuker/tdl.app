#appRoot
  .container-fluid
    .row
      - @user = User.first
      ul style="background-image: none; padding-right: 15px;"
        - @user.tags.each do |tag|
          li style="color: grey;"
            span style="color: #{tag.color};" = tag.title
            span<>
              | (Tasks:
            = tag.tasks.size
            span )
        li style="color: grey;"
          span style="color: white;" No Tags
          span<>
            | (Tasks:
          = @user.tasks.select{ |task| task.tags.empty? }.size
          span )
    .row
      .col-md-6
        marquee[direction="right" scrollamount="15" behavior="alternate"]
          h3
            | {{ title.taskList }}
        marquee[direction="right" scrollamount="1" behavior="alternate"]
          |  <input type="text" class="form-control" placeholder="Search for tasks..." v-model="search">
        ul.list-group.tasklistPane
          li.list-group-item[v-for="(task,index) in tasks" v-show="task.completed != true"]
            |  <input type="checkbox" :id="'incompleted-task-id-' + index " v-model="task.completed" @change="taskCompleted(task)">
            label[:for="'incompleted-task-id-' + index "]
              | {{task.title}}
            .btn-group.pull-right
              |  <button class="btn btn-success btn-xs" @click="editTaskIndex = index">
              i.fa.fa-pencil[aria-hidden="true"]
              |  <button class="btn btn-danger btn-xs" @click="deleteTask(index)">
              i.fa.fa-trash-o[aria-hidden="true"]
          li.list-group-item[v-if="editTaskIndex < 0"]
            |  <input type="text" class="form-control" placeholder="Type and hit enter" ref="newTask" @keyup.enter="addTask">
          li.list-group-item[v-if="editTaskIndex > -1"]
            .has-success
              |  <input type="text" class="form-control" placeholder="Exit and hit enter" v-model="tasks[editTaskIndex].title" @keyup.enter="edited(editTaskIndex), editTaskIndex = -1" @keyup.enter="edited">
      .col-md-6
        div[v-if="completeTasks.length > 0"]
          marquee[scrollamount="13" behavior="alternate"]
            h3
              | {{ title.completedTasks }}
          ul.list-group
            li.list-group-item[v-for="(task,index) in tasks" v-show="task.completed == true"]
              |  <input type="checkbox" :id="'completed-task-id-' + index " v-model="task.completed" @change="taskUndoCompleted(task)">
              label[:for="'completed-task-id-' + index "]
                | {{task.title}}
= javascript_pack_tag 'task_list'
