<div id="appRoot">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-6">
        <h3>{{ title.taskList }}</h3>
        <ul class="list-group tasklistPane" >
          <li class="list-group-item" v-for="(task,index) in tasks" v-show="task.completed != true">
            <input type="checkbox" :id="'incompleted-task-id-' + index " v-model="task.completed" @change="taskCompleted(task)">
            <label :for="'incompleted-task-id-' + index ">{{task.title}}</label>
            <div class="btn-group pull-right">
              <button class="btn btn-success btn-xs" @click="editTaskIndex = index"><i class="fa fa-pencil" aria-hidden="true"></i></button>
              <button class="btn btn-danger btn-xs" @click="deleteTask(index)"><i class="fa fa-trash-o" aria-hidden="true"></i></button>
            </div>
          </li>

          <li class="list-group-item" v-if="editTaskIndex < 0">
            <input type="text" class="form-control" placeholder="Type and hit enter" ref="newTask" @keyup.enter="addTask">
          </li>

          <li class="list-group-item" v-if="editTaskIndex > -1">
            <div class="has-success">
              <input type="text" class="form-control" placeholder="Exit and hit enter" v-model="tasks[editTaskIndex].title" @keyup.enter="edited(editTaskIndex), editTaskIndex = -1" @keyup.enter="edited">
            </div>
          </li>
        </ul>
      </div><!-- .col-md-6 -->
      <div class="col-md-6">
        <!-- Completed tasks -->
        <div v-if="completeTasks.length > 0">
          <h3>{{ title.completedTasks }}</h3>
          <ul class="list-group" >
            <li class="list-group-item" v-for="(task,index) in completeTasks">
              <input type="checkbox" :id="'completed-task-id-' + index " v-model="task.completed" @change="taskUndoCompleted(task)">
              <label :for="'completed-task-id-' + index ">{{task.title}}</label>
            </li>
          </ul>
        </div>
      </div><!-- .col-md-6 -->
    </div><!-- .row -->
  </div><!-- .container -->
</div>
<%= javascript_pack_tag 'task_list' %>
