v-dialog[v-model='editTagDialog' persistent]
  v-card
    v-card-title.headline Edit Tag Settings
    v-divider
    v-card-text[v-if='tagToBeEdited']
      p Example Usage:
      v-chip.mr-3[:color='tagToBeEdited.color' :text-color='textColor(tagToBeEdited.color)' close]
        template[v-if='editTagTitle.length > 0']
          | {{ editTagTitle }}
        template[v-else]
          | {{ tagToBeEdited.title }}
      v-chip[:color='tagToBeEdited.color']
        v-icon[:color='textColor(tagToBeEdited.color)']
          | fa-tag
      v-divider
      v-text-field[label='Tag title' :placeholder='tagToBeEdited.title' v-model='editTagTitle' clearable]
      v-color-picker[v-model='tagToBeEdited.color' mode='hexa' light hide-mode-switch]
    v-card-actions
      v-btn[@click='updateTag' color='primary'] Save
      v-btn[@click='resetTagEdit' color='secondary'] Cancel
v-dialog[v-model='createTaskDialog']
  v-card
    v-card-title.headline Create new tasks
    v-divider
    v-card-text
      v-text-field[label='Task title' v-model='newTask' @keyup.enter='addTask']
      v-divider
      h3
        | Possible Matches - {{ search.length }}
      v-list
        v-list-item-group
          v-list-item[v-for='task in search' :key='task.title']
            v-list-item-content
              v-list-item-title
                | {{ task.title }}
    v-card-actions
      v-spacer
      v-btn[@click='createTaskDialog = false' color='secondary'] Close
v-dialog[v-model='currentTaskDialog']
  v-card
    v-card-title.headline Task Details
    v-divider
    v-card-text
      h3.primary--text
        | {{ currentTask.title }}
      v-row
        v-col
          v-text-field[label='Task title' :placeholder='currentTask.title' v-model='editTaskTitle' clearable]
          v-select[label='Tags' v-model='currentTags' :items='tags' item-text='title' item-value='title' multiple clearable]
            template v-slot:selection="{ item, index }"
              v-chip[:color='item.color' :text-color='item.text_color' :key='item.title']
                | {{ item.title }}
          v-select[label='List' v-model='currentList' :items='lists' item-text='title' item-value='title']
          v-datetime-picker[label='Remind me at' v-model='editRemindMeAt' @input='updateRemindMeAt']
            v-icon[slot='dateIcon']
              | fa-calendar
            v-icon[slot='timeIcon']
              | fa-clock-o
          v-textarea[label='Notes' placeholder='Write some notes...' v-model='currentTask.notes']
        v-col
          v-row.pa-3
            h5
              | Prerequisites
            v-spacer
            v-btn[color='indigo']
              v-icon[left]
                | fa-link
              | Add Prerequisite
          v-list
            v-list-item-group
              v-list-item[v-for='task in currentPrereqs' :key='task.title']
                v-list-item-content[@click.stop='setCurrentTask(task)']
                  v-list-item-title
                    | {{ task.title }}
                v-chip.ml-1[v-if='task.completed' color='success']
                  | Completed
                v-chip.ml-1[v-for='tag in task.tags' :color='tag.color' :text-color='tag.text_color' :key='tag.title']
                  v-icon
                    | fa-tag
                v-list-item-action
                  v-btn[icon color='red']
                    v-icon
                      | fa-unlink
              v-list-item[v-if="currentPrereqs.length == 0"]
                v-list-item-content
                  v-list-item-title
                    strong No prerequisites.
          v-divider
          v-row.pa-3
            h5
              | Postrequisites
            v-spacer
            v-btn[color='indigo']
              v-icon[left]
                | fa-link
              | Add Postrequisite
          v-list
            v-list-item-group
              v-list-item[v-for='task in currentPostreqs' :key='task.title']
                v-list-item-content[@click.stop='setCurrentTask(task)']
                  v-list-item-title
                    | {{ task.title }}
                v-chip.ml-1[v-if='task.completed' color='success']
                  | Completed
                v-chip.ml-1[v-for='tag in task.tags' :color='tag.color' :text-color='tag.text_color' :key='tag.title']
                  v-icon
                    | fa-tag
                v-list-item-action
                  v-btn[icon color='red']
                    v-icon
                      | fa-unlink
              v-list-item[v-if="currentPostreqs.length == 0"]
                v-list-item-content
                  v-list-item-title
                    strong No postrequisites.
    v-card-actions
      v-spacer
      v-btn[@click='currentTaskDialog = false' color='secondary'] Close
v-dialog[v-model='addPreDialog']
  v-card
    v-card-title.headline Add Prerequisite
    v-divider
    v-card-text
      h3.primary--text
        | {{ currentTask.title }}
