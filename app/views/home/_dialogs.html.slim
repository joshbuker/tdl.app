v-dialog[v-model='editTagDialog' persistent]
  v-card
    v-card-title.headline Edit Tag Settings
    v-divider
    v-card-text[v-if='tagToBeEdited']
      p Example Usage:
      v-chip.mr-3[:color='tagToBeEdited.color' :text-color='textColor(tagToBeEdited.color)' close]
        template[v-if='editTagTitle.length > 0']
          | {{ editTagTitle }}
        template[v-else]
          | {{ tagToBeEdited.title }}
      v-chip[:color='tagToBeEdited.color']
        v-icon[:color='textColor(tagToBeEdited.color)']
          | fa-tag
      v-divider
      v-text-field[label='Tag title' :placeholder='tagToBeEdited.title' v-model='editTagTitle' clearable]
      v-color-picker[v-model='tagToBeEdited.color' mode='hexa' light hide-mode-switch]
    v-card-actions
      v-btn[@click='updateTag' color='primary'] Save
      v-btn[@click='resetTagEdit' color='secondary'] Cancel
v-dialog[v-model='createTaskDialog' :fullscreen='$vuetify.breakpoint.mobile']
  v-card[:tile='$vuetify.breakpoint.mobile']
    template[v-if='$vuetify.breakpoint.mobile']
      v-card-title.headline.justify-center.mt-1 Create new tasks
    template[v-else]
      v-card-title.headline.float-left.mt-1 Create new tasks
    v-row.pt-3[justify='center' no-gutters]
      v-btn.ma-2[@click='createTaskDialog = false' color='secondary' :small='$vuetify.breakpoint.mobile'] Close
    v-divider
    v-card-text
      v-select[label='Tags' v-model='createTaskTags' :items='tags' item-text='title' item-value='title' multiple clearable]
        template v-slot:selection="{ item, index }"
          v-chip[:color='item.color' :text-color='item.text_color' :key='item.title']
            | {{ item.title }}
      v-select[label='List' v-model='createTaskList' :items='lists' item-text='title' item-value='title']
      v-text-field[label='Task title' v-model='newTask' @keyup.enter='addTask']
      v-switch[v-model='searchEnabled' label='Auto Search']
      v-btn[@click='searchForTasks' text-with-icon]
        v-icon[left]
          | fa-search
        | Search
      v-divider
      h3
        | Possible Matches - {{ search.length }}
      v-list
        v-list-item-group
          v-list-item[v-for='task in search' :key='task.title']
            v-list-item-content[@click.stop='setCurrentTask(task)']
              v-list-item-title
                | {{ task.title }}
= render partial: 'current_task_dialog'
- %w[Pre Post].each do |dry|
  v-dialog[v-model="add#{dry}Dialog" :fullscreen='$vuetify.breakpoint.mobile']
    v-card[:tile='$vuetify.breakpoint.mobile']
      template[v-if='$vuetify.breakpoint.mobile']
        v-card-title.headline.justify-center = "Add #{dry}requisite"
      template[v-else]
        v-card-title.headline.float-left.mt-1 = "Add #{dry}requisite"
      v-row.pt-3[justify='center' no-gutters]
        v-btn.ma-2[@click="add#{dry}Dialog = false" color='secondary' :small='$vuetify.breakpoint.mobile'] Close
      v-divider
      v-card-text
        h5.primary--text
          | {{ currentTask.title }}
        v-divider
        v-text-field[label='Task title' v-model='newTask' @keyup.enter="add#{dry}Task"]
        v-switch[v-model='searchEnabled' label='Auto Search']
        v-btn[@click='searchForTasks' text-with-icon]
          v-icon[left]
            | fa-search
          | Search
        v-divider
        h3
          | Possible Matches - {{ search.length }}
        v-list
          v-list-item-group
            v-list-item[v-for='task in search' :key='task.title']
              v-list-item-content[@click.stop="add#{dry}requisite(task)"]
                v-list-item-title
                  | {{ task.title }}
v-dialog[v-model='reviewDialog' persistent :fullscreen='$vuetify.breakpoint.mobile']
  v-card
    v-toolbar[dark color='primary']
      v-spacer
      v-btn[:disabled='reviewWaiting == true' fab dark @click='endReview']
        v-icon
          | fa-close
    v-card-text
      p
        | {{ reviewQueue.length }} tasks remaining.
      v-divider
      h1[v-if='currentReviewTask != undefined']
        | {{ currentReviewTask.title }}
    v-divider
    v-card-actions.justify-center
      template[v-if='reviewButtons == "now"']
        v-btn.darken-1[:disabled='reviewWaiting == true' fab color='green' @click='reviewToday']
          v-icon
            | fa-bell-slash-o
        v-btn.darken-1[:disabled='reviewWaiting == true' fab color='green']
          | 9am
        v-btn.darken-1[:disabled='reviewWaiting == true' fab color='green']
          | 5pm
        v-btn.darken-1[:disabled='reviewWaiting == true' fab color='green']
          v-icon
            | fa-ellipsis-h
        v-btn[fab color='secondary' @click='reviewButtons = "root"']
          v-icon
            | fa-arrow-left
      template[v-else-if='reviewButtons == "later"']
        v-btn.darken-3[:disabled='reviewWaiting == true' fab color='yellow' @click='reviewTomorrow']
          v-icon
            | fa-chevron-right
        v-btn.darken-3[:disabled='reviewWaiting == true' fab color='yellow' @click='reviewNextWeek']
          v-icon
            | fa-forward
        v-btn.darken-3[:disabled='reviewWaiting == true' fab color='yellow' @click='reviewUpcoming']
          v-icon
            | fa-step-forward
        v-btn.darken-3[:disabled='reviewWaiting == true' fab color='yellow' @click='reviewSomeday']
          v-icon
            | fa-question
        v-btn[fab color='secondary' @click='reviewButtons = "root"']
          v-icon
            | fa-arrow-left
      template[v-else]
        v-btn.darken-1[fab color='green' @click='reviewButtons = "now"']
          v-icon
            | fa-arrow-down
        v-btn.darken-3[fab color='yellow' @click='reviewButtons = "later"']
          v-icon
            | fa-arrow-right
        v-btn.darken-1[:disabled='reviewWaiting == true' fab color='blue' @click='reviewDone']
          v-icon
            | fa-check
        v-btn.darken-1[:disabled='reviewWaiting == true' fab color='red' @click='reviewDelete']
          v-icon
            | fa-close
        v-btn[fab style='visibility: hidden;']
          v-icon
            | fa-bitcoin
