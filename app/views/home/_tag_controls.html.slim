template v-if='editControls != true'
  v-list[nav]
    v-list-item-group[v-model='selectedTag' @change='refreshTasks' color='primary' mandatory]
      v-list-item[link v-for='tag in tags' :key='tag.title' :value='tag.title' :color='tag.color']
        v-list-item-content
          v-list-item-title
            | {{ tag.title }}
          v-list-item-subtitle
            | {{ tag.task_count }} tasks
template[v-else]
  v-list[nav]
    v-list-item-group
      draggable
        v-list-item[v-for='tag in tags' :key='tag.title']
          v-list-item-icon
            v-icon
              | fa-bars
          v-list-item-content
            v-list-item-title
              | {{ tag.title }}
            v-list-item-subtitle
              | {{ tag.task_count }} tasks
          v-list-item-action
            v-btn[icon color='primary' @click.stop='editTag(tag)']
              v-icon
                | fa-pencil
          v-list-item-action
            v-btn[icon color='red' @click.stop="deleteTag"]
              v-icon
                | fa-trash
  v-text-field.mx-4[label='Create new tag' filled dense rounded append-icon='fa-arrow-up']
